---
import site from "../data/site.json";
import opening from "../data/hero-media.json";
import MediaControls from "./MediaControls.astro";
import { asset } from "../data/paths";
---

<section class="hero visual-hero hero-film-section" aria-labelledby="paper-title">
  <div class="hero-film hero-single" id="hero-stage">
    <figure>
      <video id="opening-video" data-playback-group="hero" controls controlslist="nodownload" muted playsinline loop preload="metadata" poster={asset(opening.poster)} width={opening.width} height={opening.height} aria-label={opening.title} aria-describedby="opening-visual-description">
        <source src={asset(opening.video)} type="video/mp4" />
        <track kind="descriptions" src={asset(opening.track)} srclang="en" label="English visual descriptions" />
        <a href={asset(opening.video)}>View the silent city traffic video.</a>
      </video>
    </figure>
  </div>
  <p class="sr-only" id="opening-visual-description">{opening.description.join(" ")}</p>
  <div class="hero-publication">
    <h1 id="paper-title" class="project-display-title">{site.title}</h1>
    <ul class="authors">
      {site.authors.map((author) => <li><a href={`mailto:${author.email}`}>{author.name}</a></li>)}
    </ul>
    <div class="actions">
      <a class="button dark" href={site.paperUrl}>Paper ↗</a>
    </div>
  </div>
  <p id="media-status" class="sr-only" role="status"></p>
</section>
<MediaControls />
