<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-playback-group="hero"]')];
  const button = document.querySelector<HTMLButtonElement>("#hero-playback-toggle");
  const region = document.querySelector<HTMLElement>(".hero-backdrops");
  const status = document.querySelector<HTMLElement>("#media-status");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const connection = (navigator as Navigator & {
    connection?: EventTarget & { saveData?: boolean };
  }).connection;
  if (button && region && videos.length) {
    let manuallyPaused = false;
    let inView = false;
    let request = 0;
    const systemPauses = new WeakSet<HTMLVideoElement>();
    const allowed = () => !reduced.matches && !connection?.saveData;
    const update = () => {
      button.textContent = videos.some((v) => !v.paused && !v.ended)
        ? "Pause videos" : "Play videos";
    };
    const pause = () => {
      request++;
      for (const video of videos) {
        if (!video.paused) {
          systemPauses.add(video);
          video.pause();
        }
      }
      button.removeAttribute("aria-busy");
      update();
    };
    const play = async (manual = false) => {
      if (!manual && (manuallyPaused || !allowed() || !inView || document.hidden)) return;
      if (manual) manuallyPaused = false;
      const current = ++request;
      button.setAttribute("aria-busy", "true");
      const outcomes = await Promise.allSettled(videos.map((video) => video.play()));
      if (current !== request) return;
      button.removeAttribute("aria-busy");
      if (outcomes.some((outcome) => outcome.status === "rejected" && outcome.reason?.name !== "AbortError")) {
        pause();
        if (status) status.textContent = "Use Play videos or the player controls to start playback.";
      } else if (status) status.textContent = "";
      update();
    };
    for (const video of videos) {
      video.addEventListener("play", update);
      video.addEventListener("pause", () => {
        if (systemPauses.has(video)) systemPauses.delete(video);
        else manuallyPaused = true;
        update();
      });
      video.addEventListener("ended", update);
      video.addEventListener("error", update);
    }
    button.hidden = false;
    button.addEventListener("click", () => {
      if (videos.some((v) => !v.paused && !v.ended)) {
        manuallyPaused = true;
        pause();
      } else void play(true);
    });
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting && entry.intersectionRatio >= 0.15;
      if (inView) void play();
      else pause();
    }, { threshold: [0, 0.15] });
    observer.observe(region);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) pause();
      else void play();
    });
    const preferenceChanged = () => {
      if (!allowed()) pause();
      else void play();
    };
    reduced.addEventListener("change", preferenceChanged);
    connection?.addEventListener("change", preferenceChanged);
    update();
  }
</script>
