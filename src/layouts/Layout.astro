---
import "@fontsource-variable/ibm-plex-sans";
import "../styles/global.css";
import site from "../data/site.json";
import { asset } from "../data/paths";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = site.title, description = site.description, noindex = false } = Astro.props;
const isNotFound = /\/404(?:\/|\.html)?$/.test(Astro.url.pathname);
const canonical =
  Astro.site && !isNotFound
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const nav = ["Abstract", "Method", "Results", "Citation"].map((name) => ({
  name, href: `${asset()}#${name.toLowerCase()}`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#202020" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {(isNotFound || noindex) && <meta name="robots" content="noindex" />}
    <meta name="citation_title" content={site.title} />
    {
      site.authors.map((author) => (
        <meta name="citation_author" content={author.name} />
      ))
    }
    <meta name="citation_publication_date" content={site.year} />
    <meta name="citation_doi" content={site.doi} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      canonical && (
        <>
          <>
            <link rel="canonical" href={canonical} />
            <meta property="og:url" content={canonical} />
            <meta
              property="og:image"
              content={new URL(asset(site.contextPoster), Astro.site).href}
            />
            <meta property="og:image:alt" content={site.contextDescription} />
          </>
        </>
      )
    }
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href={asset("favicon.svg?v=mixed-traffic-road")}
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <a
        class="wordmark"
        href={asset()}
        aria-label={`${site.wordmark} — project home`}
        ><span class="mark" aria-hidden="true">↗</span>{site.wordmark}</a
      >
      <nav aria-label="Main navigation">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={
                Astro.url.pathname.replace(/\/$/, "") ===
                item.href.replace(/\/$/, "")
                  ? "page"
                  : undefined
              }
            >
              {item.name}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top">
        <span class="wordmark">{site.wordmark}</span><a href="#main"
          >Back to top ↑</a
        >
      </div>
      <div class="footer-links">
        <a href={asset("accessibility/")}>Accessibility & media credits</a><a
          href="mailto:liusongyang@ufl.edu">Contact Songyang Liu</a
        >
      </div>
      <p class="fine-print">
        Based on the <a
          href="https://github.com/RomanHauksson/academic-project-astro-template"
          >Academic Project Astro Template</a
        > by Roman Hauksson.
      </p>
    </footer>
  </body>
</html>
