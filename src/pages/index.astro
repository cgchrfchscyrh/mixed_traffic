---
import stories from "../data/vision-stories.json";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Figure from "../components/Figure.astro";
import PresentationFigure from "../components/PresentationFigure.astro";
import ResearchClip from "../components/ResearchClip.astro";
import Citation from "../components/Citation.astro";
import evidence from "../data/evidence.json";
---
<Layout title={stories.mixed.headline} bare>
  <Hero />
  <div class="container visual-overview">
    <section class="section evidence-section" id="context" aria-labelledby="context-title">
      <h2 id="context-title">Intersections are where crashes and delays build up, and robot vehicles already share the road.</h2>
      <div class="evidence-grid">
        {evidence.map(tile => <article class="evidence-tile">
          <h3>{tile.label}</h3>
          <p class="evidence-value">{tile.value}</p>
          <p class="evidence-text">{tile.text}</p>
          <a href={tile.source} aria-label={`Source for ${tile.label}: ${tile.sourceName}`}>Source ↗</a>
        </article>)}
      </div>
    </section>
    <section class="section abstract-section" id="abstract" aria-labelledby="abstract-title">
      <h2 id="abstract-title">From one intersection to a road network</h2>
      <div class="media-pair wide-media">
        <div class="clip-with-bubble">
          <Figure id="network" bare />
          <p class="clip-bubble"><strong>The study network.</strong> 14 intersections in Colorado Springs, simulated in SUMO.</p>
        </div>
        <div class="clip-with-bubble">
          <ResearchClip id="network" />
          <p class="clip-bubble"><strong>Connected roads.</strong> Vehicles move between neighboring intersections.</p>
        </div>
      </div>
    </section>
    <section class="section" id="method" aria-labelledby="method-title">
      <h2 id="method-title">How we trained it</h2>
      <div class="method-map wide-media">
        <div class="method-map-figure"><PresentationFigure id="method" concise /></div>
        <h3 class="sr-only">What the figure shows</h3>
        <p class="method-bubble method-bubble-robot"><strong>Robot vehicles.</strong> Near an intersection, they switch to the learned policy.</p>
        <p class="method-bubble method-bubble-human"><strong>Human vehicles.</strong> They follow the Intelligent Driver Model. So do robot vehicles away from intersections.</p>
        <p class="method-bubble method-bubble-observe"><strong>What each robot sees.</strong> Queue lengths, waiting times, and occupancy at its intersection.</p>
        <p class="method-bubble method-bubble-policy"><strong>One shared policy.</strong> Rainbow DQN trains it. Each vehicle decides on its own.</p>
        <p class="method-bubble method-bubble-action"><strong>Stop or Go.</strong> Within 30 m of an intersection, the policy picks one of the two.</p>
      </div>
      <div class="intersection-grid wide-media"><PresentationFigure id="signalized" concise /><PresentationFigure id="unsignalized" concise /></div>
    </section>
    <section class="section" id="results" aria-labelledby="results-title">
      <h2 id="results-title" class="sr-only">Simulation</h2>
      <div class="media-pair wide-media">
        <div class="clip-with-bubble">
          <ResearchClip id="junction" />
          <p class="clip-bubble"><strong>At the intersection.</strong> Vehicles pass through a four-way junction.</p>
        </div>
        <div class="clip-with-bubble">
          <ResearchClip id="flow" />
          <p class="clip-bubble"><strong>Across the network.</strong> Vehicles move and queue on the roads between junctions.</p>
        </div>
      </div>
    </section>
    <Citation />
  </div>
</Layout>
