---
import Layout from "../layouts/Layout.astro";
import Figure from "../components/Figure.astro";
import PresentationFigure from "../components/PresentationFigure.astro";
import narrative from "../data/narrative.json";
import site from "../data/site.json";
import { asset } from "../data/paths";

const openingSections = [
  { id: "guide-problem", title: "The problem", content: narrative.problem },
  {
    id: "guide-existing-work",
    title: "Existing approaches",
    content: narrative.relatedWork,
  },
  { id: "guide-gap", title: "The knowledge gap", content: narrative.gap },
];
const guideContents = [
  ...openingSections.map(({ id, title }) => ({ id, title })),
  ...site.guideSections.map((section, i) => ({
    id: `guide-${i + 1}`,
    title: section.title,
  })),
];
---

<Layout title={`Research guide — ${site.wordmark}`}>
  <div class="reading-container">
    <header class="page-title">
      <p class="eyebrow">{site.venue}</p><h1>Research guide</h1><p class="lead">
        {site.title}
      </p><p>{site.guideIntro}</p><div class="actions">
        <a class="button dark" href={site.paperUrl}>Published paper ↗</a>{
          site.htmlPaper && (
            <a class="button" href={site.htmlPaper}>
              Full preprint in HTML ↗
            </a>
          )
        }{
          site.pdfUrl && (
            <a class="button" href={site.pdfUrl}>
              {site.pdfLabel} ↗
            </a>
          )
        }
      </div>
    </header>
    <nav class="contents" aria-label="Research guide contents">
      <h2>In this guide</h2><ol>
        {
          guideContents.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title}</a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="prose">
      <p class="fine-print">
        The opening overview adapts the ground-transportation discussion in the
        author’s proposal presentation, slides 15–16. The method illustration
        below is adapted from slide 18. Technical details and numeric results
        follow the published paper, including cases that qualify the
        presentation’s broader conclusions.
      </p>
      <Fragment>
        {
          openingSections.map((section) => (
            <section id={section.id}>
              <h2>{section.title}</h2>
              <p>{section.content.intro}</p>
            </section>
          ))
        }
      </Fragment>
      <Fragment>
        {
          site.guideSections.map((section, i) => (
            <section id={`guide-${i + 1}`}>
              <h2>{section.title}</h2>
              {section.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
              {i === 1 && <PresentationFigure id="method" />}
            </section>
          ))
        }
      </Fragment>
      <section>
        <h2>Boundaries of the evidence</h2><ul>
          {site.limitations.map((p) => <li>{p}</li>)}
        </ul>
      </section>
    </div>
    <Figure id={site.id === "mixed_traffic" ? "network" : "wind"} />
    <section class="section">
      <h2>Continue with the evidence</h2><p>
        <a href={asset("results/")}
          >Read the original figure descriptions and numeric results</a
        >, including downloadable CSV tables.
      </p><p><a href={site.repo}>{site.repoLabel}</a>. {site.repoNote}</p><p
        class="fine-print"
      >
        The uploaded publisher PDF was used to verify this guide and extract the
        original figures. It remains unchanged. External publisher PDFs and the
        arXiv preprint have not been certified for accessibility; <a
          href={asset("accessibility/#attachments")}
          >read the attachment notes</a
        >.
      </p>
    </section>
  </div>
</Layout>
