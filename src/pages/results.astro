---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import { asset } from "../data/paths";
---
<Layout title={`Research findings — ${site.wordmark}`} noindex>
  <div class="reading-container page-title">
    <h1>Research findings</h1>
    <p>The project now presents its research on one page.</p>
    <p><a href={`${asset()}#results`}>Continue to the results section</a>.</p>
    <p><a href={site.paperUrl}>Read the published paper</a> for the full study.</p>
  </div>
</Layout>
